# Resend (https://resend.com) — contact form delivery.
# Create an API key at https://resend.com/api-keys and copy this file to .env.local.
RESEND_API_KEY=

# Inbox that receives new enquiries.
CONTACT_TO_EMAIL=

# Sender shown on enquiry emails. Must use a domain verified in Resend.
# For local testing you can use: Website <onboarding@resend.dev>
# (Resend's test sender only delivers to your own Resend account email.)
CONTACT_FROM_EMAIL=
